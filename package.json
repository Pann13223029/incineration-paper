{
  "name": "incineration-paper",
  "private": true,
  "description": "Paper-focused derivative workspace seeded from the incineration thesis repo",
  "scripts": {
    "repo:check": ".venv/bin/python code/publishing/24_validate_repo_layout.py",
    "paper:check": ".venv/bin/python code/publishing/20_sync_paper_assets.py --check",
    "paper:sync": ".venv/bin/python code/publishing/20_sync_paper_assets.py",
    "claims:verify": ".venv/bin/python code/analysis/08_verify_claims.py",
    "analysis:test": ".venv/bin/python -m unittest discover -s code/tests -p 'test_*.py'",
    "analysis:rebuild": ".venv/bin/python code/analysis/07_rebuild_analysis.py",
    "paper:export": ".venv/bin/python code/publishing/21_export_paper_submission.py",
    "paper:export:nopdf": ".venv/bin/python code/publishing/21_export_paper_submission.py --no-pdf",
    "paper:build:latex": ".venv/bin/python code/publishing/22_build_paper_latex.py --profile journal",
    "paper:build:professor": ".venv/bin/python code/publishing/22_build_paper_latex.py --profile professor",
    "slides:paper": ".venv/bin/python code/publishing/23_export_paper_zoom_slides.py",
    "slides:paper:pdf": ".venv/bin/python code/publishing/23_export_paper_zoom_slides.py --pdf",
    "legacy:slides:export": ".venv/bin/python legacy/scripts/09_export_defense_slides.py",
    "legacy:slides:export:pdf": ".venv/bin/python legacy/scripts/09_export_defense_slides.py --pdf",
    "legacy:slides:bundle": ".venv/bin/python legacy/scripts/10_package_defense_bundle.py",
    "legacy:packets:build": ".venv/bin/python legacy/scripts/11_package_review_packets.py",
    "legacy:supervisor:ready": ".venv/bin/python legacy/scripts/15_prepare_supervisor_handoff.py",
    "legacy:checkpoint:freeze": ".venv/bin/python legacy/scripts/12_freeze_checkpoint.py",
    "legacy:review:round:start": ".venv/bin/python legacy/scripts/13_start_review_round.py"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.2.3"
  }
}
